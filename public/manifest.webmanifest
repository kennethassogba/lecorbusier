        {
          "src": "/lecorbusier/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Mes créations",
      "url": "/lecorbusier/?view=mine"
    },
    {
      "name": "Top",
      "url": "/lecorbusier/?view=top"
    }
  ],
  "screenshots": [
